config BMTH_ENABLE
    bool "Enable HMS Benchmark Tool"
    default n
    help
      Select this option to enable the HMS Benchmark Tool.

config BMTH_FRDM_MCXN947
    depends on BMTH_ENABLE
    bool "FRDM-MCXN947"
    default n
    help
      Select this option to enable the FRDM-MCXN947 board support for the HMS Benchmark Tool.
